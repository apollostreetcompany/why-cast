{
  "name": "why-cast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "npm run build && concurrently -k -n BUILD,WORKER -c magenta,cyan \"vite build --watch --emptyOutDir=false\" \"wrangler dev\"",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:local": "echo \"Configure D1 and apply migrations before running local DB setup.\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.1",
    "framer-motion": "^12.38.0",
    "hono": "^4.10.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "vite": "^7.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260401.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.2"
  }
}
